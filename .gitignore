# ==============================================================================
# V.O.I.D. — Git Ignore Specification
# ==============================================================================

# OS & System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.tmp
*~

# Python Bytecode & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Sensitive Credentials
.env
.env*.local
.env.production
.env.staging
credentials.json
token.json
*.pem
*.key
*.pfx

# Large Machine Learning Models & Checkpoints (>100MB)
*.pt
*.pth
*.bin
checkpoint.pt
checkpoint_model.pt
checkpoint_step600.pt.bak
*.bak
*.onnx
*.safetensors
*.gguf
*.task
checkpoints/
weights/
vision/data/models/
void_memory/models/

# Local Runtime Databases & Ephemeral Logs
*.db
*.sqlite3
logs/
scratch/
.void_desktop_profile/
training_state.json

# Node.js & Web Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel/
.vercel

# Flutter & Dart
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies

# IDEs & Text Editors
.idea/
.vscode/
*.swp
*.swo
tempCodeRunnerFile.py

# Whitelist Critical Repository Assets
!docs/assets/
!docs/assets/*
!static/
!void_studio/lib/
!void_flutter/lib/
