# ==============================================================================
# V.O.I.D. — Environment Configuration Example (.env)
# ==============================================================================

# Server Network Configuration
VOID_HOST=127.0.0.1
VOID_PORT=5000
VOID_DEBUG=false

# Compute Device & Execution Mode
# Choices: "cuda" (for NVIDIA GPU with >= 4GB VRAM) or "cpu"
VOID_DEVICE=cuda

# Local-First Strict Isolation
# When set to true, external outbound queries are bypassed unless explicitly requested
VOID_OFFLINE_MODE=true

# Optional: Cloud / Local Ollama LLM Fallback (if local transformer is bypassed)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Vision & Optical Telemetry
VISION_ENABLED=true
VISION_CAMERA_INDEX=0
VISION_FPS=30
VISION_MODEL_PATH=yolov8s-worldv2.pt

# Voice Engine Settings
VOICE_ENABLED=false
VOICE_WAKEWORD="hey void"
VOICE_SAMPLE_RATE=16000

# Android Phone Bridge (ADB)
ADB_ENABLED=true
ADB_DEVICE_SERIAL=""
